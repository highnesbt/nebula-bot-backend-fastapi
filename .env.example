# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./nebula.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nebula

# Auth
SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# Encryption — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEBULA_ENCRYPTION_KEY=generate-a-fernet-key

# Broker backend: live | paper | mock
NEBULA_BROKER_BACKEND=mock

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
